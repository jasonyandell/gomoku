__pycache__/
*.pyc
*.so
.venv/
.pytest_cache/
*.egg-info/
dist/
build/

checkpoints/
checkpoints_*/
wandb/
runs/
scratch/
sweep_runs/
sweep_logs/
lab_queue/
archives/
*.pt
*.ckpt

.DS_Store
.claude/*
!.claude/skills/
!.claude/workflows/

# Per-worktree owner record written by scripts/worktree_session.py (find session
# logs later via `claude --resume`). The durable registry lives in .git/ and is
# never tracked. See wiki/topics/branch-and-worktree-workflow.md.
.claude-session

# Per-worktree GitHub-issue marker written by scripts/gh_worktree.py (the worker
# reads it for `Closes #N`). Ephemeral per worktree — never tracked.
.gh_issue

# Frontier lab runtime artifacts (keep .frontier/config.json and lanes.json tracked)
.frontier/runs/
.frontier/worktrees/
.frontier/tmp/

# app/ (Vite + TS SPA)
node_modules/
app/dist/
.wrangler/

# Rapfi external-engine yardstick: ignore the source clone/build (88MB) and the
# built binary; keep the build script + BUILD_COMMIT.txt provenance tracked so
# the binary is reproducible via engines/rapfi/build_rapfi.sh.
.rapfi-build/
engines/rapfi/pbrain-rapfi
engines/rapfi/*.bin.lz4
engines/rapfi/model210901.bin

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# bd auto-rewrites this on every write; tracking it forces every worker to
# stash/restore it before `git merge --no-ff`. Untracked here per derby-58y
# (2026-05-28); on-disk copy is kept fresh by bd's auto-export. The canonical
# store lives in .beads/embeddeddolt/ (also untracked).
.beads/issues.jsonl

mined/                 # rapfimine output (large npz shards; #86 idx-2 mine)
